{
  "expo": {
    "name": "captain-app",
    "slug": "captain-app",
    "version": "1.0.0",
    "scheme": "captain-app",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neelaakhil13.captainapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.neelaakhil13.captainapp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-image-picker",
      "react-native-maps"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c2b56b46-7f33-4bee-abb3-c4827c08bc3d"
      }
    },
    "owner": "neelaakhil13"
  }
}
